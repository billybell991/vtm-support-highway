{
  "manifest_version": 3,
  "name": "VTM Support Highway",
  "version": "1.0.0",
  "description": "Create and link tickets across Zendesk, Jira Server, and Aha from any support app.",
  "permissions": ["storage", "activeTab", "tabs", "cookies"],
  "host_permissions": [
    "https://*.zendesk.com/*",
    "https://*.zdusercontent.com/*",
    "http://*.versaterm.com/*",
    "https://*.versaterm.com/*",
    "https://*.aha.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VTM Support Highway"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://atlassian.versaterm.com:8080/browse/SUP-*"],
      "js": ["content-jira.js"],
      "css": ["content-jira.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://versatermhelp.zendesk.com/agent/tickets/*"],
      "js": ["content-zendesk.js"],
      "css": ["content-zendesk.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
